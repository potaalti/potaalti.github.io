rules_version = '2';

// BSL Draft Ligi güvenlik kuralları.
// - Herkes (giriş kodu olmayan izleyiciler dahil) ligi okuyabilir.
// - Her menajer kendi gizli koduyla takımına bağlanır (uyeler/{uid}); sadece kendi takımı adına işlem yapar.
// - Draftta sırası gelen takım seçer; süre dolunca herhangi bir menajerin ekranı otomatik seçimi yapar.
// - Bir oyuncu tek takımda olabilir (alinan/{oyuncu} belgesi bir kez oluşturulabilir).
// - Sezon boyunca: 2 serbest oyuncu alma, 1 As–Yedek değişikliği; takaslar iki tarafın onayıyla.
// - Yönetici (admin kodu) her şeyi düzeltebilir.
service cloud.firestore {
  match /databases/{database}/documents {

    function uyeYolu() { return /databases/$(database)/documents/uyeler/$(request.auth.uid); }
    function uye() { return request.auth != null && exists(uyeYolu()); }
    function benimTakim() { return get(uyeYolu()).data.takim; }
    function yonetici() { return uye() && benimTakim() == 'admin'; }
    function durum() { return get(/databases/$(database)/documents/lig/durum).data; }
    function ayar() { return get(/databases/$(database)/documents/lig/ayar).data; }
    function kadro(tid) { return get(/databases/$(database)/documents/kadrolar/$(tid)).data; }
    function kadroSonra(tid) { return getAfter(/databases/$(database)/documents/kadrolar/$(tid)).data; }
    function oyunculari(k) { return k.as.concat(k.yedek); }

    // İlk kurulum: lig/ayar henüz yokken, onu oluşturan tek toplu yazmanın parçası
    function kurulumda() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/lig/ayar)
        && existsAfter(/databases/$(database)/documents/lig/ayar);
    }

    // ---------- Lig ayarları ve draft durumu ----------
    match /lig/{doc} {
      allow read: if true;
      allow create: if kurulumda();
      allow update: if yonetici() || (doc == 'durum' && secimIlerlemesi());
    }

    // Bir seçim yapılınca sıra bir sonraki seçime geçer, saat yeniden başlar
    function secimIlerlemesi() {
      let eski = resource.data;
      let yeni = request.resource.data;
      let n = eski.secimNo;
      let secim = /databases/$(database)/documents/secimler/$(string(n));
      return uye() && eski.asama == 'draft'
        && !exists(secim) && existsAfter(secim)
        && yeni.diff(eski).affectedKeys().hasOnly(['secimNo', 'saatBaslangic', 'saatSure', 'asama'])
        && yeni.secimNo == n + 1
        && yeni.saatBaslangic == request.time
        && yeni.saatSure == ayar().secimSuresi
        && yeni.asama == (n + 1 == eski.toplamSecim ? 'kadro' : 'draft');
    }

    // ---------- Draft seçimleri ----------
    match /secimler/{n} {
      allow read: if true;
      allow create: if secimGecerli(n);
      allow delete: if yonetici(); // son seçimi geri alma
    }

    function secimGecerli(n) {
      let d = durum();
      let s = request.resource.data;
      let o = get(/databases/$(database)/documents/oyuncular/$(s.oyuncu)).data;
      let k = kadro(s.takim);
      // Türk kuralı: As'ın son yuvasında As'ta Türk yoksa, Yedeğin son yuvasında Yedekte Türk yoksa
      // sadece Türk oyuncu seçilebilir
      let asDolu = k.as.size() == ayar().asSayisi;
      let turkZorunlu = asDolu ? (k.yedek.size() == ayar().yedekSayisi - 1 && k.yedekTurk == 0)
                               : (k.as.size() == ayar().asSayisi - 1 && k.asTurk == 0);
      let suresiDoldu = request.time > d.saatBaslangic + duration.value(d.saatSure, 's');
      return d.asama == 'draft'
        && n == string(d.secimNo) && s.no == d.secimNo
        && s.takim == d.secimSirasi[d.secimNo]
        && s.keys().hasOnly(['no', 'tur', 'takim', 'oyuncu', 'ad', 'bslTakim', 'turk', 'otomatik', 'zaman'])
        && s.zaman == request.time
        && s.turk == o.turk && s.ad == o.ad
        && !exists(/databases/$(database)/documents/alinan/$(s.oyuncu))
        && getAfter(/databases/$(database)/documents/alinan/$(s.oyuncu)).data.takim == s.takim
        && getAfter(/databases/$(database)/documents/lig/durum).data.secimNo == d.secimNo + 1
        && (!turkZorunlu || s.turk == true)
        && (yonetici()
            || (s.otomatik == false && benimTakim() == s.takim)
            // Otomatik seçim: süre dolmuş olmalı ve oyuncu müsait en iyi 15 içinden olabilecek biri olmalı
            || (s.otomatik == true && uye() && suresiDoldu
                && (turkZorunlu ? o.turkSira : o.sira) <= d.secimNo + 15));
    }

    // ---------- Takımı olan oyuncular (bir oyuncu tek takımda) ----------
    match /alinan/{pid} {
      allow read: if true;
      allow create: if yonetici() || draftAlimi(pid) || faAlimi(pid);
      allow update: if yonetici() || takasla(pid);
      allow delete: if yonetici() || faBirakma(pid);
    }

    function draftAlimi(pid) {
      let secim = /databases/$(database)/documents/secimler/$(string(request.resource.data.secim));
      return !exists(secim) && getAfter(secim).data.oyuncu == pid
        && request.resource.data.keys().hasOnly(['takim', 'secim']);
    }

    function faAlimi(pid) {
      let tid = request.resource.data.takim;
      return uye() && tid == benimTakim() && durum().asama == 'sezon'
        && kadroSonra(tid).sonFa == pid && kadroSonra(tid).fa == kadro(tid).fa + 1
        && request.resource.data.keys().hasOnly(['takim', 'fa']);
    }

    function faBirakma(pid) {
      let tid = resource.data.takim;
      return uye() && tid == benimTakim() && durum().asama == 'sezon'
        && !(pid in oyunculari(kadroSonra(tid))) && kadroSonra(tid).fa == kadro(tid).fa + 1;
    }

    function takasla(pid) {
      let tyol = /databases/$(database)/documents/teklifler/$(request.resource.data.teklif);
      let t = getAfter(tyol).data;
      return uye() && get(tyol).data.durum == 'bekliyor' && t.durum == 'kabul' && benimTakim() == t.alan
        && request.resource.data.keys().hasOnly(['takim', 'secim', 'fa', 'teklif'])
        && ((pid in t.verilen && resource.data.takim == t.veren && request.resource.data.takim == t.alan)
            || (pid in t.alinan && resource.data.takim == t.alan && request.resource.data.takim == t.veren));
    }

    // ---------- Fantezi takım kadroları ----------
    match /kadrolar/{tid} {
      allow read: if true;
      allow create: if kurulumda() || yonetici();
      allow update: if yonetici() || kadroDraft(tid) || dizilisKurulumu(tid)
        || asYedekDegisikligi(tid) || serbestOyuncu(tid) || takasKadrosu(tid);
    }

    function kadroDuzgun(k) {
      return k.as.size() == ayar().asSayisi && k.yedek.size() == ayar().yedekSayisi
        && oyunculari(k).toSet().size() == oyunculari(k).size();
    }

    // Kadro geçmişi: her değişiklik sona yeni bir giriş ekler; eski haftalar değişmez
    function gecmisEklendi(eski, yeni) {
      let n = eski.gecmis.size();
      let son = yeni.gecmis[n];
      return yeni.gecmis.size() == n + 1 && yeni.gecmis[0:n] == eski.gecmis
        && son.keys().hasOnly(['hafta', 'as', 'yedek', 'tur'])
        && son.hafta >= durum().aktifHafta && son.as == yeni.as && son.yedek == yeni.yedek;
    }

    // Draftta seçilen oyuncu takımın kadrosuna eklenir
    function kadroDraft(tid) {
      let eski = resource.data;
      let yeni = request.resource.data;
      let secim = /databases/$(database)/documents/secimler/$(string(yeni.sonSecim));
      let s = getAfter(secim).data;
      // İlk 5 seçim As'a, sonrakiler Yedeğe girer
      let asa = eski.as.size() < ayar().asSayisi;
      return !exists(secim) && s.takim == tid
        && yeni.diff(eski).affectedKeys().hasOnly(['as', 'yedek', 'asTurk', 'yedekTurk', 'sonSecim'])
        && oyunculari(yeni) == oyunculari(eski).concat([s.oyuncu])
        && yeni.as.size() == eski.as.size() + (asa ? 1 : 0)
        && yeni.asTurk == eski.asTurk + (asa && s.turk ? 1 : 0)
        && yeni.yedekTurk == eski.yedekTurk + (!asa && s.turk ? 1 : 0);
    }

    // Draft bitti, sezon başlamadı: takım As/Yedek dizilişini serbestçe kurar
    function dizilisKurulumu(tid) {
      let eski = resource.data;
      let yeni = request.resource.data;
      return uye() && benimTakim() == tid && durum().asama == 'kadro'
        && yeni.diff(eski).affectedKeys().hasOnly(['as', 'yedek'])
        && kadroDuzgun(yeni) && oyunculari(yeni).toSet() == oyunculari(eski).toSet();
    }

    // Sezon boyunca tek As–Yedek değişikliği
    function asYedekDegisikligi(tid) {
      let eski = resource.data;
      let yeni = request.resource.data;
      return uye() && benimTakim() == tid && durum().asama == 'sezon'
        && yeni.diff(eski).affectedKeys().hasOnly(['as', 'yedek', 'degisiklik', 'gecmis'])
        && yeni.degisiklik == eski.degisiklik + 1 && yeni.degisiklik <= ayar().degisiklikHakki
        && kadroDuzgun(yeni) && oyunculari(yeni).toSet() == oyunculari(eski).toSet()
        && gecmisEklendi(eski, yeni);
    }

    // Serbest oyuncu: bir oyuncu bırakılır, takımı olmayan bir oyuncu alınır (sezonda en fazla 2)
    function serbestOyuncu(tid) {
      let eski = resource.data;
      let yeni = request.resource.data;
      let eskiSet = oyunculari(eski).toSet();
      let yeniSet = oyunculari(yeni).toSet();
      let alinan = /databases/$(database)/documents/alinan/$(yeni.sonFa);
      return uye() && benimTakim() == tid && durum().asama == 'sezon'
        && yeni.diff(eski).affectedKeys().hasOnly(['as', 'yedek', 'fa', 'sonFa', 'gecmis'])
        && yeni.fa == eski.fa + 1 && yeni.fa <= ayar().faHakki
        && kadroDuzgun(yeni)
        && yeniSet.difference(eskiSet) == [yeni.sonFa].toSet() && eskiSet.difference(yeniSet).size() == 1
        && !exists(alinan) && getAfter(alinan).data.takim == tid
        && gecmisEklendi(eski, yeni);
    }

    // Kabul edilen takas: iki takımın kadrosu da kabul eden takımın tek işleminde değişir
    function takasKadrosu(tid) {
      let eski = resource.data;
      let yeni = request.resource.data;
      let tyol = /databases/$(database)/documents/teklifler/$(yeni.sonTeklif);
      let t = getAfter(tyol).data;
      let giden = tid == t.veren ? t.verilen : t.alinan;
      let gelen = tid == t.veren ? t.alinan : t.verilen;
      return uye() && benimTakim() == t.alan && durum().asama == 'sezon'
        && get(tyol).data.durum == 'bekliyor' && t.durum == 'kabul'
        && (tid == t.veren || tid == t.alan)
        && yeni.diff(eski).affectedKeys().hasOnly(['as', 'yedek', 'sonTeklif', 'gecmis'])
        && kadroDuzgun(yeni)
        && oyunculari(eski).toSet().hasAll(giden)
        && oyunculari(yeni).toSet() == oyunculari(eski).toSet().difference(giden.toSet()).union(gelen.toSet())
        && gecmisEklendi(eski, yeni);
    }

    // ---------- Takas teklifleri ----------
    match /teklifler/{id} {
      allow read: if true;
      allow create: if uye() && durum().asama == 'sezon' && teklifGecerli(request.resource.data);
      allow update: if yonetici() || teklifYaniti(id) || teklifIptali();
      allow delete: if yonetici(); // draftı sıfırlama
    }

    function teklifGecerli(t) {
      return t.keys().hasOnly(['veren', 'alan', 'verilen', 'alinan', 'durum', 'zaman', 'not'])
        && t.veren == benimTakim() && t.alan != t.veren
        && exists(/databases/$(database)/documents/takimlar/$(t.alan))
        && t.durum == 'bekliyor' && t.zaman == request.time
        && t.verilen.size() >= 1 && t.verilen.size() <= 3 && t.verilen.size() == t.alinan.size()
        && (!('not' in t) || (t['not'] is string && t['not'].size() <= 200));
    }

    function teklifYaniti(id) {
      let t = request.resource.data;
      return uye() && benimTakim() == resource.data.alan && resource.data.durum == 'bekliyor'
        && t.diff(resource.data).affectedKeys().hasOnly(['durum', 'yanitZamani'])
        && t.yanitZamani == request.time
        && (t.durum == 'red'
            || (t.durum == 'kabul' && durum().asama == 'sezon'
                && kadroSonra(resource.data.veren).sonTeklif == id
                && kadroSonra(resource.data.alan).sonTeklif == id));
    }

    function teklifIptali() {
      let t = request.resource.data;
      return uye() && benimTakim() == resource.data.veren && resource.data.durum == 'bekliyor'
        && t.diff(resource.data).affectedKeys().hasOnly(['durum', 'yanitZamani'])
        && t.durum == 'iptal' && t.yanitZamani == request.time;
    }

    // ---------- Takımlar (ad ve menajer) ----------
    match /takimlar/{tid} {
      allow read: if true;
      allow create: if kurulumda() || yonetici();
      allow update: if yonetici()
        || (uye() && benimTakim() == tid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ad'])
            && request.resource.data.ad is string
            && request.resource.data.ad.size() >= 2 && request.resource.data.ad.size() <= 30);
    }

    // ---------- Hareket kaydı (herkesin görebildiği işlem geçmişi) ----------
    match /hareketler/{id} {
      allow read: if true;
      allow create: if uye() && request.resource.data.zaman == request.time
        && (yonetici() || request.resource.data.takim == benimTakim());
      allow update, delete: if yonetici();
    }

    // ---------- Draft havuzu (yönetici draft öncesi yükler) ----------
    match /oyuncular/{pid} {
      allow read: if true;
      allow write: if yonetici();
    }

    // ---------- Giriş kodları ----------
    match /kodlar/{kod} {
      allow read: if yonetici();
      allow create: if kurulumda() || yonetici();
      allow update, delete: if yonetici();
    }

    match /uyeler/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || yonetici());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['takim', 'kod'])
        && ((kurulumda() && request.resource.data.takim == 'admin')
            || get(/databases/$(database)/documents/kodlar/$(request.resource.data.kod)).data.takim == request.resource.data.takim);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Sunucu saati (geri sayımın herkeste aynı olması için) ----------
    match /saat/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }
  }
}
